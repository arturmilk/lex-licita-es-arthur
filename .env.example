# Estima.IA — variáveis de ambiente (copiar para .env)
DATABASE_URL=postgresql://estimaia:SUA_SENHA@localhost:5432/estimaia
AUTH_SECRET=gere_um_segredo_longo
AUTH_TRUST_HOST=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=estimaia
MINIO_SECRET_KEY=SUA_SENHA_MINIO
MINIO_BUCKET=estimaia
AGENT_API_KEY=chave_api_agentes
DEEPSEEK_API_KEY=chave_deepseek
# PNCP: deixar vazio para acesso direto (VPS no Brasil);
# preencher apenas se usar proxy via túnel (VPS fora do Brasil)
PNCP_PROXY_URL=
PNCP_PROXY_TOKEN=
# Base dos Dados (BigQuery) — opcional, espelho PNCP
GOOGLE_SA_JSON=
GOOGLE_SA_FILE=
