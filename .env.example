# Database
DATABASE_URL=postgresql://estimaia:estimaia123@localhost:5432/estimaia

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secret-here-change-in-production

# MinIO Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=estimaia
MINIO_SECRET_KEY=estimaia123
MINIO_BUCKET=estima-ia

# PNCP API
PNCP_BASE_URL=https://pncp.gov.br/api/pncp/v1

# App
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal API Key for agents (generate with: openssl rand -hex 32)
AGENT_API_KEY=your-agent-api-key-here

# DeepSeek API (agentes IA — compatível com OpenAI)
# Gere em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
